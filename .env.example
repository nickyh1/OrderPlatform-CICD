# GHCR应用镜像
IMAGE_NAME=ghcr.io/nickyh1/order-platform-cicd
IMAGE_TAG=sha-REPLACE_WITH_FULL_GIT_SHA

# 应用只绑定服务器回环地址的8081端口
APP_HOST_PORT=8081

# MySQL
MYSQL_DATABASE=order_platform
MYSQL_USER=order_app
MYSQL_PASSWORD=replace-with-strong-random-value
MYSQL_ROOT_PASSWORD=replace-with-another-strong-random-value

# Redis
REDIS_PASSWORD=replace-with-strong-random-value

# RabbitMQ
RABBITMQ_USER=order_app
RABBITMQ_PASSWORD=replace-with-strong-random-value

# 应用运行参数
STOCK_STRATEGY=redis
TZ=Asia/Shanghai
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai"